# Gosslan 公网中转 —— 环境变量示例
#
# 用法：复制为 /etc/gosslan-relay.env（PM2 / systemd 都会读它），然后：
#   sudo chmod 600 /etc/gosslan-relay.env
# 逐项含义与默认值见 README「配置项」。
#
# ⚠️ TOKEN 必填。生成强口令：openssl rand -hex 16
#    无口令、或口令短于 16 字符且监听非回环地址，都会以退出码 2 拒绝启动。
TOKEN=change…x-16

# 以下各项都有默认值，仅在需要修改时取消注释。
# PORT=59993
# HOST=0.0.0.0
# MAX_CLIENTS=128
# HELLO_TIMEOUT_MS=10000
# WAIT_TIMEOUT_MS=30000
# IDLE_TIMEOUT_MS=180000
# PENDING_MAX=1048576
# 健康检查端点（默认只绑回环；PM2 配置与 Docker 镜像已默认启用 59994）
# HEALTHZ_PORT=59994
# HEALTHZ_HOST=127.0.0.1
# LOG=1
# STATS=1
