# Gosslan 公网中转 —— 环境变量示例
#
# 用法：复制为 /etc/gosslan-relay.env（PM2 / systemd 都会读它），然后按部署形态设权限：
#   PM2：sudo chown <PM2运行用户>:<组> /etc/gosslan-relay.env && sudo chmod 600 …（PM2 进程要能读）
#   systemd：保持 root:root + chmod 600（EnvironmentFile 由 systemd 以特权读取）
# 逐项含义、默认值与合法范围见 README「配置项」。
#
# ⚠️ TOKEN 必填。生成强口令：openssl rand -hex 16
#    无口令、或口令短于 16 字符且监听非回环地址，都会以退出码 2 拒绝启动。
TOKEN=change…x-16

# 以下各项都有默认值，仅在需要修改时取消注释。
# PORT=59993
# HOST=0.0.0.0
# MAX_CLIENTS=128
# HELLO_TIMEOUT_MS=10000
# WAIT_TIMEOUT_MS=30000
# IDLE_TIMEOUT_MS=180000
# PENDING_MAX=1048576
# v7 通知 API + 健康检查端点（同一 HTTP 端点，PM2/Docker 默认启用）。
# 要接通知机器人：端口必须开、HOST 必须非回环，否则外部客户端连不上。
# HEALTHZ_PORT=59994
# HEALTHZ_HOST=0.0.0.0
# LOG=1
# STATS=1

# ---------------------------------------------------------------- v7 通知机器人（复用 59994）
#
# 旧 v6 的 WEBHOOK_* / webhook.mjs / 59995 已彻底删除，**不要再照抄**。
# 本仓现只支持 v7：一个进程复用上面的 59994，token 在 URL，无 request header / 幂等键 / 图片。
# 完整部署与使用说明见 README-v7-notify.md。
#
# WEBHOOK_DATA_DIR=./webhook-data        # 队列落盘目录（notify-bots.json / notify-queue.json）
# NOTIFY_TTL_MS=604800000               # 未送达通知留存期（默认 7 天）
# NOTIFY_MAX_EVENTS=10000               # 全服事件硬上限；满了 503 背压，不静默丢
# NOTIFY_PULL_MAX=50                    # 单次取件上限
