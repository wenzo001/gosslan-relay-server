# Gosslan 公网中转 —— 环境变量示例
#
# 用法：复制为 /etc/gosslan-relay.env（PM2 / systemd 都会读它），然后按部署形态设权限：
#   PM2：sudo chown <PM2运行用户>:<组> /etc/gosslan-relay.env && sudo chmod 600 …（PM2 进程要能读）
#   systemd：保持 root:root + chmod 600（EnvironmentFile 由 systemd 以特权读取）
# 逐项含义、默认值与合法范围见 README「配置项」。
#
# ⚠️ TOKEN 必填。生成强口令：openssl rand -hex 16
#    无口令、或口令短于 16 字符且监听非回环地址，都会以退出码 2 拒绝启动。
TOKEN=change…x-16

# 以下各项都有默认值，仅在需要修改时取消注释。
# PORT=59993
# HOST=0.0.0.0
# MAX_CLIENTS=128
# HELLO_TIMEOUT_MS=10000
# WAIT_TIMEOUT_MS=30000
# IDLE_TIMEOUT_MS=180000
# PENDING_MAX=1048576
# 健康检查端点（默认只绑回环；PM2 配置与 Docker 镜像已默认启用 59994）
# HEALTHZ_PORT=59994
# HEALTHZ_HOST=127.0.0.1
# LOG=1
# STATS=1

# ---------------------------------------------------------------- Webhook 通知服务（独立进程）
#
# ⚠️ 这是**另一个进程**的配置（`node webhook.mjs`），与上面的 TCP 盲中继**互不影响**。
#    它的信任模型完全相反：会收到消息明文并暂存（网关离线期间）⇒ 必须放在 HTTPS 反代后面。
#
# WEBHOOK_PORT=59995
# WEBHOOK_HOST=127.0.0.1
# WEBHOOK_CLIENT_TOKEN=change…x-16      # 必填：客户端（网关）注册/取件用的服务器级令牌
# WEBHOOK_PEPPER=change…x-32            # 必填：bot 密钥摘要的 pepper（换它等于轮换全部 bot 密钥）
# WEBHOOK_DATA_DIR=./webhook-data        # 队列与附件的落盘目录
# WEBHOOK_MAX_TEXT_BYTES=8192
# WEBHOOK_MAX_IMAGES=4
# WEBHOOK_MAX_IMAGE_BYTES=5242880
# WEBHOOK_MAX_REQUEST_BYTES=25165824
# WEBHOOK_QUEUE_DEPTH_PER_BOT=500
# WEBHOOK_QUEUE_TTL_MS=604800000
#  ↓ 内存/磁盘防膨胀（审计 2026-11-17）：
# WEBHOOK_MAX_EVENTS_TOTAL=10000         # 全服事件硬上限；到了回 503 背压，不静默丢
# WEBHOOK_DONE_RETENTION_MS=3600000      # 已送达/已过期事件保留 1h 后物理删除（含附件）
# WEBHOOK_INDEX_TTL_MS=604800000         # 幂等索引/限流桶空闲 7d 淘汰，防 Map 无限增长
# WEBHOOK_LEASE_MS=60000
# WEBHOOK_PULL_BATCH=20
# WEBHOOK_RATE_PER_MIN=60
